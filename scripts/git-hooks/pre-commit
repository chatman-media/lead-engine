#!/usr/bin/env bash
# Pre-commit hook installed via `bun run hooks:install`.
# Source of truth lives in scripts/git-hooks/pre-commit so the team
# stays in sync — .git/hooks/ is per-clone and untracked.
#
# Skip via:  git commit --no-verify    (use sparingly)
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=AM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# 1. Secret scan — only staged-and-added/modified files. Cheap.
echo "[pre-commit] secret scan…"
bun run scripts/scan-secrets.ts --staged

# 2. Biome check — only staged TS/TSX files (skip if none).
TS_STAGED=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx)$' || true)
if [ -n "$TS_STAGED" ]; then
  echo "[pre-commit] biome check on staged…"
  # `--no-errors-on-unmatched` so files outside includes (e.g. inside
  # node_modules) don't fail the hook on edge-case adds.
  echo "$TS_STAGED" | xargs bunx biome check --no-errors-on-unmatched
fi

echo "[pre-commit] ok"
