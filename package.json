{
  "name": "tg-chatbot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": ["admin-ui"],
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "build:ui": "bun run --cwd admin-ui build",
    "dev:ui": "bun run --cwd admin-ui dev"
  },
  "dependencies": {
    "sqlite-vec": "^0.1.9",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": []
}
