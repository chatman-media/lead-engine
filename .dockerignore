# Don't ship dev-only / runtime / secret files into the image. The
# build-context size also matters — sending node_modules across the
# build daemon can push image build to 2x slower.

# Node / Bun deps & caches — installed inside the image
**/node_modules
**/.bun
**/.cache
**/dist
admin-ui/dist

# Local data + logs — must come from a volume in production
data/
*.db
*.db-journal
*.db-shm
*.db-wal
logs/
*.log

# Secrets — operators mount their .env at run time, never in the image
.env
.env.local
.env.*.local
sec/

# VCS / CI / IDE
.git
.github
.gitignore
.husky
.vscode
.idea
.claude

# Tests / coverage — production image runs nothing of this
tests/
playwright.config.ts
playwright-report/
test-results/
coverage/

# Source artifacts of the KB pipeline — keep text files, skip binaries
kb/**/*.webp
kb/**/*.tgs
kb/**/*.mp4
kb/**/*.mp3
kb/**/*.ogg
kb/**/*.jpg
kb/**/*.jpeg
kb/**/*.png
kb/**/*.gif

# OS junk
.DS_Store
Thumbs.db
*.swp
*~

# Documentation that doesn't ship to runtime. Scoped to root-level so the
# `kb/**/*.md` content (the entire knowledge base) DOES make it into the
# image — a bare `*.md` here would silently strip every KB file and the
# in-container ingest would end up with only voice transcripts.
docs/
/README.md
/CHANGELOG.md
