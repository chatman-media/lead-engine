PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SERVE_UI=1

DB_PATH=./data/bot.db

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me

# LLM provider: "openai" (any OpenAI-compatible API) or "ollama" (local).
LLM_PROVIDER=openai

# --- openai (also works for any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# --- ollama (local; no API key required) ---
# Make sure `ollama serve` is running and you have pulled the models:
#   ollama pull llama3.1
#   ollama pull nomic-embed-text
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Must match the dimensionality of the chosen embedding model:
#   nomic-embed-text -> 768
#   mxbai-embed-large -> 1024
#   bge-m3 -> 1024
OLLAMA_EMBEDDING_DIM=768

ADMIN_SESSION_COOKIE=tg_admin_sid
ADMIN_SESSION_TTL_DAYS=14

# --- bot persona (how the bot identifies itself in chat) ---
# BOT_PERSONA_ROLE:
#   "human"     — bot speaks as a real human manager and never admits to being
#                 an AI/bot/language model. Use for sales-style chats where
#                 the user shouldn't notice they're talking to a model.
#   "assistant" — explicit AI-assistant persona, openly describes itself as
#                 an automated helper.
BOT_PERSONA_NAME=Менеджер
BOT_PERSONA_ROLE=human
BOT_PERSONA_COMPANY=
