# --- userbot (respond as your personal Telegram account via MTProto) --------
# 1. Go to https://my.telegram.org, sign in, create an application — copy api_id and api_hash.
# 2. Fill in TELEGRAM_API_ID and TELEGRAM_API_HASH below.
# 3. Run once: bun scripts/userbot-auth.ts (enters your phone + OTP + optional 2FA).
# 4. Set TELEGRAM_USERBOT=1 and restart the server — the bot will auto-reply to your DMs.
# TELEGRAM_USERBOT=0
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
#
# Optional: route MTProto through a proxy when your server's egress IP
# can't reach Telegram DCs directly (geoblock, ISP filter). Accepted formats
# (parser handles all three on every line):
#   host:port:secret
#   tg://proxy?server=H&port=P&secret=S
#   https://t.me/proxy?server=H&port=P&secret=S
#
# Single proxy — operator updates the value when it dies:
# USERBOT_MTPROXY=
#
# Or a newline-separated list (takes precedence over USERBOT_MTPROXY). The
# userbot tries entries in order, falls back to the next on connect TIMEOUT,
# first working proxy wins. Empty lines and `#`-prefixed comments skipped.
# Per-attempt connect deadline configurable via USERBOT_PROXY_CONNECT_TIMEOUT_SEC
# (default 45s).
# USERBOT_MTPROXY_LIST="
# https://t.me/proxy?server=194.120.230.199&port=25565&secret=dd...
# https://t.me/proxy?server=quickrouteapp.xyz&port=443&secret=ee...
# # backup — slower but more stable
# host.example.com:443:dd...
# "
# USERBOT_PROXY_CONNECT_TIMEOUT_SEC=45
#
# A malformed single value (or an entirely-invalid list) aborts the userbot
# subprocess loudly (no silent fallback to direct that would defeat the point
# on a blocked server). Individual unparseable lines in a list are skipped
# with a warning.
# Note: the proxy operator sees connection metadata; pick a source you trust.

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SERVE_UI=1

# PostgreSQL connection string. For local dev, start PostgreSQL and create a database.
# For production, use Supabase (free tier works) or any hosted PostgreSQL.
DATABASE_URL=postgres://postgres:password@localhost:5432/tgchatbot

# Separate disposable DB for `bun run test`. Tests run TRUNCATE CASCADE between
# cases — getTestSql() refuses to run unless host=localhost OR db-name has "test"
# in it, so production DATABASE_URL is safe. Create it once:
#   createdb tgchatbot_test
#   psql tgchatbot_test -c "CREATE EXTENSION IF NOT EXISTS vector;"
# Fake embedders use dim=8; activeEmbeddingDim() must agree, hence the overrides:
TEST_DATABASE_URL=postgres://localhost/tgchatbot_test
# OPENAI_EMBEDDING_DIM=8
# OLLAMA_EMBEDDING_DIM=8

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me

# Accept any Telegram sender: auto-create users row on first message (no manual whitelist).
# Use 0 / false / off to require pre-created users rows.
TELEGRAM_OPEN_ACCESS=0

# Lead pipeline (optional). Group chat ids where bot posts the lead /
# visa-submission cards. Leave unset to use admin UI only — leads still
# work end-to-end, just without Telegram cards. Bot must be added to
# both chats (admin role recommended so it can edit cards in place
# after approve / reject). Get the id by adding the bot to the group
# and running /get-chat-id (or check getUpdates).
# LEADS_CHAT_ID=-100123456789       # групповой чат «Лиды»
# VISA_CHAT_ID=-100987654321        # групповой чат «Подача на визу»

# LLM chat provider: "openai" | "ollama" | "openrouter"
# Embeddings are configured separately (EMBEDDING_PROVIDER below) — OpenRouter
# is chat-only, so even when LLM_PROVIDER=openrouter you need an embedder.
LLM_PROVIDER=openai

# Embedding provider: "openai" | "ollama"
# Default = match LLM_PROVIDER when openai/ollama. When LLM_PROVIDER=openrouter
# default is "ollama" (cheapest path; embedders are 100M-500M params, fine on CPU).
# EMBEDDING_PROVIDER=ollama

# --- openai (also works for any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# --- ollama (local; no API key required) ---
# Make sure `ollama serve` is running and you have pulled the models:
#   ollama pull llama3.1
#   ollama pull nomic-embed-text
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Must match the dimensionality of the chosen embedding model:
#   nomic-embed-text -> 768
#   mxbai-embed-large -> 1024
#   bge-m3 -> 1024
OLLAMA_EMBEDDING_DIM=768

# --- openrouter (Claude, GPT, Gemini, Llama, Qwen via one key) ---
# Get a key at https://openrouter.ai/keys (~$0.50-2.00 for casual testing).
# Recommended sales-bot models:
#   anthropic/claude-haiku-4.5     — cheap, fast, great Russian
#   anthropic/claude-sonnet-4.6    — premium style adherence
#   openai/gpt-4o-mini             — fast and cheap
#   google/gemini-2.5-flash        — cheapest of the frontier-class
#   qwen/qwen3-8b                  — same Qwen3 you'd run locally, hosted
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-4.5
# Optional analytics (visible in OR dashboard) — both can stay empty.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=tg-chatbot

# --- Photo classification (vision) ---
# When enabled, each photo a candidate sends is classified via a vision
# model on OpenRouter as passport / full_body / portrait / other. This
# makes lead-intake passport detection accurate (instead of the
# "total photos >= 7" heuristic) and lets the bot acknowledge receipt.
# Reuses OPENROUTER_API_KEY / OPENROUTER_BASE_URL above.
VISION_ENABLED=false
# OpenRouter slug of a vision-capable model. google/gemini-2.5-flash is
# cheap and strong at document recognition.
VISION_MODEL=google/gemini-2.5-flash

# --- RAG retrieval (pgvector cosine distance, top-K chunks sent to the LLM) ---
# Lower RAG_MAX_DISTANCE = stricter: weak hits are dropped → more escalations.
# Leave empty to disable the distance threshold (use whatever top-K returns).
RAG_MAX_DISTANCE=1.00
RAG_TOP_K=5

ADMIN_SESSION_COOKIE=tg_admin_sid
ADMIN_SESSION_TTL_DAYS=14

# --- bot persona (how the bot identifies itself in chat) ---
# BOT_PERSONA_ROLE:
#   "human"     — bot speaks as a real human manager and never admits to being
#                 an AI/bot/language model. Use for sales-style chats where
#                 the user shouldn't notice they're talking to a model.
#   "assistant" — explicit AI-assistant persona, openly describes itself as
#                 an automated helper.
BOT_PERSONA_NAME=Менеджер
BOT_PERSONA_ROLE=human
BOT_PERSONA_COMPANY=
# Personal facts about the operator the bot pretends to be — JSON object.
# Bot uses these when a candidate asks "где живёшь?" / "сколько лет?" /
# "какой номер?" etc., bypassing RAG with a deterministic reply.
# Known keys: city, age, status, phone (extend as needed).
# BOT_PERSONA_FACTS={"city":"Шаохинг","age":"26","phone":"+1 555 123 4567"}

# --- sales-style engine (optional, opt-in) ---------------------------------
# When set to a Style.slug, the bot uses the sales-style engine instead of
# the BOT_PERSONA_* path above. Style-based prompts compose:
#   persona + voice + framework (AIDA/PAS/SPIN/NEPQ/Belfort) + Cialdini hooks
#   + per-stage guidance (opener → qualify → pitch → objection → close)
#   + few-shot examples + guardrails + KB CONTEXT (from RAG)
#
# Available out of the box (see src/sales/styles/):
#   flirty-belfort-v1     — Алина, флирт-рекрутер, Belfort Straight Line
#   empathetic-nepq-v1    — Маша, low-pressure NEPQ
#   cold-direct-pas-v1    — Игорь, прямой PAS, без воды
#
# See docs/SALES_STYLES.md for details.
# BOT_SALES_STYLE=flirty-belfort-v1

# --- funnel-stage routing (default = regex; opt-in to LLM classifier) ---
# Two strategies for deciding which funnel stage (opener/qualify/pitch/
# objection/close) a given inbound message belongs to:
#   regex (default) — Cyrillic-aware regex in src/sales/stage-router.ts.
#                     Sub-millisecond, predictable, free.
#   llm             — LLM classifies the message; falls back to regex when
#                     parse fails or confidence < threshold. ONE extra LLM
#                     call per inbound — adds 5-30s on Ollama+CPU, ~$0.0001
#                     on OpenRouter haiku-class. Better on nuanced phrasing.
#
# SALES_STAGE_CLASSIFIER=regex
# SALES_STAGE_CLASSIFIER_THRESHOLD=0.6
