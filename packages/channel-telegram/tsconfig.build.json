{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "paths": {},
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"]
}
