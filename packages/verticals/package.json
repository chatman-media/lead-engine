{
  "name": "@chatman-media/verticals",
  "version": "0.1.0",
  "description": "Реестр vertical templates: контракт VerticalTemplate + lookup по slug. Сами templates живут в apps/vertical-*.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "biome check ./src",
    "format": "biome format --write ./src",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "lead-engine",
    "vertical",
    "funnel-template"
  ],
  "author": "Alexander Kireev",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "1.3.14",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatman-media/lead-engine.git",
    "directory": "packages/verticals"
  },
  "homepage": "https://github.com/chatman-media/lead-engine/tree/main/packages/verticals#readme",
  "bugs": {
    "url": "https://github.com/chatman-media/lead-engine/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
