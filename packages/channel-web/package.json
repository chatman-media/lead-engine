{
  "name": "@chatman-media/channel-web",
  "version": "1.0.0",
  "description": "WebSocket-based web-chat adapter — text-only канал для in-browser клиентов. Реализует ChannelAdapter из @chatman-media/channel-core.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --external @chatman-media/channel-core && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "biome check ./src",
    "format": "biome format --write ./src",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "lead-engine",
    "channel",
    "web-chat",
    "websocket"
  ],
  "author": "Alexander Kireev",
  "license": "MIT",
  "dependencies": {
    "@chatman-media/channel-core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "1.4.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatman-media/lead-engine.git",
    "directory": "packages/channel-web"
  },
  "homepage": "https://github.com/chatman-media/lead-engine/tree/main/packages/channel-web#readme",
  "bugs": {
    "url": "https://github.com/chatman-media/lead-engine/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
