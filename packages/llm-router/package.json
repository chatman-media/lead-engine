{
  "name": "@chatman-media/llm-router",
  "version": "1.3.0",
  "description": "Per-tenant LLM routing: BYOK / platform-managed / Ollama. Маршрутизирует (tenantId, purpose) → конкретный ChatClient/EmbeddingClient.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "biome check ./src",
    "format": "biome format --write ./src",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "lead-engine",
    "llm",
    "openai",
    "openrouter",
    "ollama"
  ],
  "author": "Alexander Kireev",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "1.4.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatman-media/lead-engine.git",
    "directory": "packages/llm-router"
  },
  "homepage": "https://github.com/chatman-media/lead-engine/tree/main/packages/llm-router#readme",
  "bugs": {
    "url": "https://github.com/chatman-media/lead-engine/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
