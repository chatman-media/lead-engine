{
  "name": "@chatman-media/conversation-engine",
  "version": "0.1.0",
  "description": "Channel-agnostic pipeline обработки inbound сообщений: contact-resolve → conversation lookup → mode routing → AI-reply / queued / human → outbound. Сердце data plane.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --external '@chatman-media/*' --external drizzle-orm && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "biome check ./src",
    "format": "biome format --write ./src",
    "test": "bun test"
  },
  "keywords": [
    "lead-engine",
    "conversation",
    "pipeline",
    "multi-tenant"
  ],
  "author": "Alexander Kireev",
  "license": "MIT",
  "dependencies": {
    "@chatman-media/channel-core": "workspace:*",
    "@chatman-media/llm-router": "workspace:*",
    "@chatman-media/rag": "workspace:*",
    "@chatman-media/storage": "workspace:*",
    "@chatman-media/verticals": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "1.3.14",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.5",
    "typescript": "^6.0.3"
  }
}
