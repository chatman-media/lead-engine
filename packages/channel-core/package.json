{
  "name": "@chatman-media/channel-core",
  "version": "1.2.0",
  "description": "Channel-agnostic contract: ChannelAdapter, Inbound, OutboundEnvelope, ChannelCapabilities. Pluggable layer для Telegram / WhatsApp / web-chat / etc.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "biome check ./src",
    "format": "biome format --write ./src",
    "test": "echo 'channel-core: types-only package, contract tests live in channel-* implementations'",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "lead-engine",
    "channel",
    "messaging",
    "telegram",
    "whatsapp"
  ],
  "author": "Alexander Kireev",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "1.3.14",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatman-media/lead-engine.git",
    "directory": "packages/channel-core"
  },
  "homepage": "https://github.com/chatman-media/lead-engine/tree/main/packages/channel-core#readme",
  "bugs": {
    "url": "https://github.com/chatman-media/lead-engine/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
