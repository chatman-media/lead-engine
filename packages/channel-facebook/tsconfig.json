{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "skipLibCheck": true,
    "paths": {
      "@chatman-media/channel-core": ["../channel-core/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
