{
  "name": "@chatman-media/sales",
  "version": "1.4.0",
  "description": "LLM-powered sales funnel engine — persona composition, A/B testing, ELO rating, self-play evaluation for conversational bots.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "biome check ./src",
    "format": "biome format --write ./src",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "sales-bot",
    "llm",
    "funnel",
    "elo",
    "self-play",
    "ab-testing",
    "telegram-bot",
    "chatbot",
    "openai",
    "ollama",
    "persuasion",
    "cialdini"
  ],
  "author": "Alexander Kireev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatman-media/lead-engine.git",
    "directory": "packages/sales"
  },
  "homepage": "https://github.com/chatman-media/lead-engine/tree/main/packages/sales#readme",
  "bugs": {
    "url": "https://github.com/chatman-media/lead-engine/issues"
  },
  "dependencies": {
    "@chatman-media/conversation-engine": "workspace:*",
    "@chatman-media/kb": "workspace:*",
    "@chatman-media/llm-router": "workspace:*"
  },
  "peerDependencies": {
    "zod": ">=4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "1.3.14",
    "typescript": "^6.0.3",
    "zod": "^4.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
