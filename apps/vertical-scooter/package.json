{
  "name": "@chatman-media/vertical-scooter",
  "version": "0.1.0",
  "description": "Vertical template для аренды байков / скутеров (Пхукет, Бали, Таиланд). Data-only пакет — потребляется через @chatman-media/verticals registry.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check ./src",
    "format": "biome format --write ./src",
    "test": "bun test"
  },
  "dependencies": {
    "@chatman-media/kb": "workspace:*",
    "@chatman-media/verticals": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "1.3.14",
    "typescript": "^6.0.3"
  }
}
