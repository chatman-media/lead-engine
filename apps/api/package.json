{
  "name": "@chatman-media/api",
  "version": "0.1.0",
  "description": "HTTP-сервер платформы lead-engine: tenant API + admin API + Telegram webhooks. Принимает входящие, делает persist через conversation-engine, аппает 200 быстро (outbound — worker).",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check ./src",
    "format": "biome format --write ./src",
    "test": "bun test"
  },
  "dependencies": {
    "@chatman-media/channel-core": "workspace:*",
    "@chatman-media/channel-telegram": "workspace:*",
    "@chatman-media/channel-web": "workspace:*",
    "@chatman-media/channel-whatsapp": "workspace:*",
    "@chatman-media/conversation-engine": "workspace:*",
    "@chatman-media/kb": "workspace:*",
    "@chatman-media/llm-router": "workspace:*",
    "@chatman-media/observability": "workspace:*",
    "@chatman-media/sales": "workspace:*",
    "@chatman-media/storage": "workspace:*",
    "@chatman-media/vertical-concierge": "workspace:*",
    "@chatman-media/vertical-exchange": "workspace:*",
    "@chatman-media/vertical-real-estate": "workspace:*",
    "@chatman-media/vertical-recruitment": "workspace:*",
    "@chatman-media/vertical-saas": "workspace:*",
    "@chatman-media/vertical-video": "workspace:*",
    "@chatman-media/verticals": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "1.3.14",
    "typescript": "^6.0.3"
  }
}
