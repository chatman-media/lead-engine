{
  "name": "@chatman-media/api",
  "version": "0.1.0",
  "description": "HTTP-сервер платформы lead-engine: tenant API + admin API + Telegram webhooks. Принимает входящие, делает persist через conversation-engine, аппает 200 быстро (outbound — worker).",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check ./src",
    "format": "biome format --write ./src",
    "eval:exchange-corpus": "bun run scripts/eval-exchange-corpus.ts",
    "eval:exchange-live": "bun run scripts/eval-exchange-live.ts",
    "eval:funnel-builder": "bun run scripts/eval-funnel-builder.ts",
    "rehearse:exchange-demo": "bun run scripts/rehearse-exchange-demo.ts",
    "seed:exchange-demo": "bun run scripts/seed-exchange-demo.ts",
    "seed:exchange-fixtures": "bun run scripts/seed-exchange-fixtures.ts",
    "seed:payout-points": "bun run scripts/seed-payout-points.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@chatman-media/channel-core": "workspace:*",
    "@chatman-media/channel-facebook": "workspace:*",
    "@chatman-media/channel-max": "workspace:*",
    "@chatman-media/channel-telegram": "workspace:*",
    "@chatman-media/channel-vk": "workspace:*",
    "@chatman-media/channel-web": "workspace:*",
    "@chatman-media/channel-whatsapp": "workspace:*",
    "@chatman-media/conversation-engine": "workspace:*",
    "@chatman-media/kb": "workspace:*",
    "@chatman-media/llm-router": "workspace:*",
    "@chatman-media/observability": "workspace:*",
    "@chatman-media/sales": "workspace:*",
    "@chatman-media/storage": "workspace:*",
    "@chatman-media/vertical-concierge": "workspace:*",
    "@chatman-media/vertical-exchange": "workspace:*",
    "@chatman-media/vertical-modeling": "workspace:*",
    "@chatman-media/vertical-real-estate": "workspace:*",
    "@chatman-media/vertical-scooter": "workspace:*",
    "@chatman-media/vertical-visa": "workspace:*",
    "@chatman-media/vertical-recruitment": "workspace:*",
    "@chatman-media/vertical-saas": "workspace:*",
    "@chatman-media/vertical-video": "workspace:*",
    "@chatman-media/verticals": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.26",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "1.3.14",
    "typescript": "^6.0.3"
  }
}
